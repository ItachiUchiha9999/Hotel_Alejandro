# Copiar a .env y completar los valores del entorno local.
DATABASE_URL="postgresql://postgres:CONTRASENA@localhost:5432/sistema_hotelero_db?schema=public"
# Generar una clave aleatoria de al menos 40 caracteres y no compartirla.
AUTH_TOKEN_SECRET="REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_LARGA"
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
DEFAULT_EMPLOYEE_ID=1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
PUBLIC_WEB_URL=http://localhost:3000
