# Copiá este archivo a .env y completá los valores.
# El .env real NO se versiona (está en .gitignore).

DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/sistema_hotelero_db?schema=public"

PORT=4000
NODE_ENV=development

# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000

# Empleado al que se atribuyen los movimientos mientras no exista login real.
DEFAULT_EMPLOYEE_ID=1

# ECO-02: SMTP. Sin configurar, el correo queda pendiente en la base.
# Para pruebas locales: SMTP_HOST=127.0.0.1 y SMTP_PORT=1025 (capturador SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
PUBLIC_WEB_URL=http://localhost:3000
