# Variables de entorno del backend

Copiá este archivo a `backend/.env` y completá los valores.

# Puerto del servidor (por defecto 4000)
PORT=4000

# Cadena de conexión a PostgreSQL 17.
# Ajustá usuario, contraseña y base a tu instalación local.
DATABASE_URL="postgresql://postgres:tu_contraseña@localhost:5432/sistema_hotelero_db?schema=public"

# Empleado al que se atribuyen los movimientos mientras no haya login real
DEFAULT_EMPLOYEE_ID=1

# Orígenes permitidos para CORS, separados por coma.
# Si cambiás el puerto del frontend, agregá su origen acá.
CORS_ORIGINS=http://localhost:3000

# SMTP para los correos de confirmación de reserva (ECO-02).
# Sin estos datos, las reservas se crean pero no llega el correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# URL pública del frontend, usada en los links de los correos
PUBLIC_WEB_URL=http://localhost:3000
